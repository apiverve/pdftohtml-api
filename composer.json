{
    "name": "apiverve/pdftohtml",
    "description": "PDF to HTML converts the pages of a PDF, uploaded or fetched from a URL, into one self-contained HTML file that looks like the original: same layout, embedded fonts and images, and real selectable text. Choose a page range, unlock password-protected PDFs, or ask for text only; long documents are converted in batches, with nextPage pointing to the next one.",
    "version": "1.2.6",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "APIVerve",
            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "pdftohtml",
        "pdf to html api",
        "convert pdf to html",
        "pdf to html converter api",
        "pdf2htmlex api",
        "pdf to web page api"
    ],
    "homepage": "https://apiverve.com/marketplace/pdftohtml?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/pdftohtml",
        "source": "https://github.com/apiverve/pdftohtml-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Pdftohtml\\": "php/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
